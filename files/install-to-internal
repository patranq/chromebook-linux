#!/bin/bash
# Copies this Linux (running from the SD card / USB stick) to the internal
# disk of the Samsung Series 5 Chromebook, REMOVING ChromeOS.
#
#     sudo install-to-internal
#
# What it does on the internal disk:
#   * keeps the firmware-related partitions untouched (RWFW, EFI-SYSTEM, OEM...)
#   * removes STATE (p1) and ROOT-B (p5), grows ROOT-A (p3) over all that space
#   * writes the signed Linux kernel to KERN-A (p2), disables KERN-B (p4)
#   * creates ext4 on p3 and copies the running system onto it

set -euo pipefail

die() { echo; echo "ERROR: $*" >&2; exit 1; }
partdev() { case "$1" in *[0-9]) echo "${1}p$2" ;; *) echo "${1}$2" ;; esac; }

[ "$(id -u)" = 0 ] || die "run it as:  sudo install-to-internal"
for t in cgpt vbutil_kernel rsync mkfs.ext4 lsblk findmnt; do
  command -v "$t" >/dev/null || die "missing tool: $t"
done

# --- Where are we running from? ------------------------------------------
ROOTSRC="$(findmnt -no SOURCE /)"
ROOTDISK="/dev/$(lsblk -no PKNAME "$ROOTSRC" | head -n1)"
ROOTNUM="$(cat "/sys/class/block/$(basename "$ROOTSRC")/partition")"
SRCK="$(partdev "$ROOTDISK" $((ROOTNUM - 1)))"
echo "Running from:   $ROOTSRC (disk $ROOTDISK), kernel $SRCK"

# --- Find the internal disk ----------------------------------------------
TARGET=""
for d in $(lsblk -dnpo NAME,TYPE | awk '$2=="disk"{print $1}'); do
  [ "$d" = "$ROOTDISK" ] && continue
  case "$d" in /dev/zram*|/dev/loop*) continue ;; esac
  if [ "$(cgpt show -i 11 -l "$d" 2>/dev/null)" = "RWFW" ] && \
     [ "$(cgpt show -i 2 -l "$d" 2>/dev/null)" = "KERN-A" ]; then
    TARGET="$d"
  fi
done
[ -n "$TARGET" ] || die "internal ChromeOS disk not found (already installed?)"
echo "Internal disk:  $TARGET  ($(lsblk -dno SIZE "$TARGET"))"

# --- Plan the new layout ---------------------------------------------------
b() { cgpt show -i "$1" -b "$TARGET"; }
s() { cgpt show -i "$1" -s "$TARGET"; }

START=$(b 5)
for i in 1 3; do
  if [ "$(s $i)" -gt 0 ] && [ "$(b $i)" -lt "$START" ]; then START=$(b $i); fi
done
SEC_TABLE=$(cgpt show "$TARGET" | awk '/Sec GPT table/{print $1}')
[ -n "$SEC_TABLE" ] || die "cannot read the partition table"
LAST=$((SEC_TABLE - 1))
SIZE=$((LAST - START + 1))

for i in 2 4 6 7 8 9 10 11 12; do
  pb=$(b $i); ps=$(s $i)
  if [ "$ps" -gt 0 ] && [ $((pb + ps)) -gt "$START" ] && [ "$pb" -le "$LAST" ]; then
    die "unexpected layout: partition $i lies inside the area to be used"
  fi
done
[ "$SIZE" -gt $((4 * 1024 * 1024 * 2)) ] || die "not enough space ($SIZE sectors)"

# --- Check the kernel fits ------------------------------------------------
TMPK="$(mktemp)"
KSECT=$(s 2)
dd if="$SRCK" of="$TMPK" bs=512 count="$KSECT" status=none
vbutil_kernel --verify "$TMPK" >/dev/null 2>&1 \
  || die "the signed kernel does not fit or does not verify ($SRCK)"

echo
echo "The new root partition will be $((SIZE / 2048)) MiB."
echo
echo "!!! WARNING: ChromeOS and ALL data on the internal disk will be ERASED. !!!"
echo "    (The SD card / USB stick you are running from is not changed.)"
echo
read -r -p "Type YES (capital letters) to continue: " ans
[ "$ans" = "YES" ] || { echo "Cancelled. Nothing was changed."; exit 0; }

# --- Do it ---------------------------------------------------------------
for p in $(lsblk -lnpo NAME "$TARGET" | tail -n +2); do umount "$p" 2>/dev/null || true; done

echo "1/5 Changing partitions..."
cgpt add -i 1 -t unused -b 0 -s 0 "$TARGET"
cgpt add -i 5 -t unused -b 0 -s 0 "$TARGET"
cgpt add -i 3 -b "$START" -s "$SIZE" -t rootfs -l ROOT-A "$TARGET"

echo "2/5 Writing the kernel..."
dd if=/dev/zero of="$(partdev "$TARGET" 4)" bs=1M count=1 conv=fsync status=none 2>/dev/null || true
cgpt add -i 4 -P 0 -T 0 -S 0 "$TARGET"
dd if="$TMPK" of="$(partdev "$TARGET" 2)" bs=1M conv=fsync status=none
cgpt add -i 2 -P 15 -T 0 -S 1 "$TARGET"
rm -f "$TMPK"

blockdev --rereadpt "$TARGET" 2>/dev/null || partprobe "$TARGET" 2>/dev/null || true
udevadm settle || true
sleep 2
NEWROOT="$(partdev "$TARGET" 3)"
[ "$(blockdev --getsz "$NEWROOT")" = "$SIZE" ] || die "the kernel did not pick up the new partition table - restart from the card and run again"

echo "3/5 Creating the file system..."
mkfs.ext4 -F -q -L ROOT-INT "$NEWROOT"

echo "4/5 Copying the system (this takes 10-30 minutes)..."
MNT="$(mktemp -d)"
mount "$NEWROOT" "$MNT"
rsync -aHAXx --info=progress2 --exclude=/lost+found / "$MNT/"
sync

echo "5/5 Finishing..."
umount "$MNT"; rmdir "$MNT"
cgpt show "$TARGET"

echo
echo "=================================================================="
echo " DONE. Linux is installed on the internal disk."
echo " 1. Shut down:  sudo poweroff"
echo " 2. Remove the SD card."
echo " 3. Turn on and press Ctrl+D on the white screen."
echo "=================================================================="
